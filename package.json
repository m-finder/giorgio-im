{
  "name": "@m-finder/giorgio-im",
  "version": "0.1.3",
  "description": "A drop-in Vue 3 instant messaging widget",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-finder/giorgio-im.git"
  },
  "homepage": "https://github.com/m-finder/giorgio-im#readme",
  "bugs": {
    "url": "https://github.com/m-finder/giorgio-im/issues"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/giorgio-im.umd.cjs",
  "module": "./dist/giorgio-im.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/giorgio-im.js",
      "require": "./dist/giorgio-im.umd.cjs"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "prepack": "npm run build",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.4",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^18.19.0",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0",
    "vite-plugin-dts": "^4.5.0"
  },
  "dependencies": {
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "markdown-it": "^14.1.0"
  }
}
